# URL pública definitiva (canonical, sitemap, Open Graph). Ex.: https://www.institutobarbaralopes.com.br
NEXT_PUBLIC_SITE_URL=

# WhatsApp do Instituto, somente dígitos com DDI e DDD.
# Opcional: o número oficial (5518988270018) já é o padrão em lib/site-config.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Instagram oficial (URL completa)
NEXT_PUBLIC_INSTAGRAM_URL=

# Registro profissional validado (ex.: "CRBM-1 nº 00000"). Exibido no rodapé apenas quando preenchido.
NEXT_PUBLIC_PROFESSIONAL_REGISTRATION=

# CNPJ / razão social, quando houver
NEXT_PUBLIC_LEGAL_ENTITY=

# Ferramentas de análise (opcionais). Só carregam após consentimento do visitante.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
